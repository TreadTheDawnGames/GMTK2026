[resource]
script = ExtResource("1_config")
chamber_height_rows = 24
chamber_ceiling_inset_cells = 12
farewell_actor_ids = Array[StringName]([&"cheese_girl", &"treasure_hunter", &"rutini", &"moody_teen", &"coffee_cat", &"cloak_lantern"])
encounters = Array[ExtResource("2_encounter_type")]([ExtResource("3_cheese_girl"), ExtResource("4_treasure_first"), ExtResource("5_rutini_first"), ExtResource("6_treasure_second"), ExtResource("8_moody_teen"), ExtResource("9_rutini_second"), ExtResource("10_treasure_treasure"), ExtResource("11_coffee_cat"), ExtResource("12_cloak_lantern"), ExtResource("13_farewell"), ExtResource("7_thief")])
