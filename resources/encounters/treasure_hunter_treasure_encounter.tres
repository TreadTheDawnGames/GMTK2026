[gd_resource type="Resource" script_class="DepthCharacterEncounter" format=3]

[ext_resource type="Script" path="res://resources/encounters/depth_character_encounter.gd" id="1_encounter"]
[ext_resource type="Resource" path="res://resources/encounters/treasure_hunter_character_appearance.tres" id="2_appearance"]
[ext_resource type="Resource" path="res://resources/dialogue/treasure_hunter_treasure_conversation.tres" id="3_dialogue"]
[ext_resource type="Resource" path="res://resources/pickaxes/seismic_pickaxe.tres" id="4_pickaxe"]
[ext_resource type="PackedScene" path="res://Scenes/cinematics/treasure_hunter_hoard_encounter_stage.tscn" id="5_stage"]
[ext_resource type="Resource" path="res://resources/cinematics/sequences/treasure_hunter_treasure_sequence.tres" id="5_uctft"]
[ext_resource type="Resource" path="res://resources/cinematics/sculpts/treasure_hunter_treasure_room.tres" id="7_uctft"]

[resource]
script = ExtResource("1_encounter")
encounter_id = &"treasure_hunter_treasure"
actor_id = &"treasure_hunter"
depth_from_surface = 7400
appearance = ExtResource("2_appearance")
conversation = ExtResource("3_dialogue")
stage_scene = ExtResource("5_stage")
sequence = ExtResource("5_uctft")
prestage_before_landing = true
speaker_slot = &"treasure_hunter"
pickaxe_reward = ExtResource("4_pickaxe")
terrain_sculpt = ExtResource("7_uctft")
