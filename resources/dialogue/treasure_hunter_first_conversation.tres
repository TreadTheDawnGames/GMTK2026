[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://b7gqdpkvcu0sy"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_meeting"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Whoa! Mightn't have thought I'd meet another miner down here."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_search"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Nice to meet you, but I've got five million dollars of buried treasure to find!"

[sub_resource type="Resource" id="Line_tool"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "You're digging with that? That pickaxe will take forever down here."

[sub_resource type="Resource" id="Line_spare"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Take my spare. It's a proper mining tool, and it'll get you moving faster."

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_treasure_hunter"]
script = ExtResource("2_participant")
slot = &"treasure_hunter"
display_name = "Treasure Hunter"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"treasure_hunter_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_treasure_hunter")])
lines = Array[ExtResource("3_line")]([SubResource("Line_meeting"), SubResource("Line_miner"), SubResource("Line_search"), SubResource("Line_tool"), SubResource("Line_spare")])
