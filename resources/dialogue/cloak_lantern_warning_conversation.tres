[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://dd1ja2k32r6v0"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_return"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "You kept digging. Then hear my warning clearly."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_thief"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "The Thief is not a tale. The Thief waits far below."

[sub_resource type="Resource" id="Line_warning"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "Be certain before you keep digging."

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cloak_lantern"]
script = ExtResource("2_participant")
slot = &"cloak_lantern"
display_name = "Lantern Keeper"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cloak_lantern_warning"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cloak_lantern")])
lines = Array[ExtResource("3_line")]([SubResource("Line_return"), SubResource("Line_miner"), SubResource("Line_thief"), SubResource("Line_warning")])
