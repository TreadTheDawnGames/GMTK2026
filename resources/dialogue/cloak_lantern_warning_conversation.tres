[gd_resource type="Resource" script_class="DialogueConversation" load_steps=10 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cloak_lantern"]
script = ExtResource("2_participant")
slot = &"cloak_lantern"
display_name = "Lantern Keeper"

[sub_resource type="Resource" id="Line_years"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "I've mined these passages for years. The others are already preparing to leave."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_stone"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "Beyond us, only miles of stone lie between you and the Thief."

[sub_resource type="Resource" id="Line_errand"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "I can't stop you, but it is a fool's errand. Take this final tool if you insist."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cloak_lantern_warning"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cloak_lantern")])
lines = Array[ExtResource("3_line")]([SubResource("Line_years"), SubResource("Line_miner"), SubResource("Line_stone"), SubResource("Line_errand")])
