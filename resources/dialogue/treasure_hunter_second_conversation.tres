[gd_resource type="Resource" script_class="DialogueConversation" load_steps=13 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_treasure_hunter"]
script = ExtResource("2_participant")
slot = &"treasure_hunter"
display_name = "Treasure Hunter"

[sub_resource type="Resource" id="Line_again"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "You again?!"

[sub_resource type="Resource" id="Line_miner_one"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_worry"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "What was that? You're not here for the treasure?"

[sub_resource type="Resource" id="Line_miner_two"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_relief"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Well, I'll be. You had me worried. I've been hunting this treasure for years!"

[sub_resource type="Resource" id="Line_telly"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Everyone says it's a waste of time, but all they ever do is watch the telly."

[sub_resource type="Resource" id="Line_below"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Maybe we'll meet again at a lower depth. Take this heavy spare and keep digging."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"treasure_hunter_second"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_treasure_hunter")])
lines = Array[ExtResource("3_line")]([SubResource("Line_again"), SubResource("Line_miner_one"), SubResource("Line_worry"), SubResource("Line_miner_two"), SubResource("Line_relief"), SubResource("Line_telly"), SubResource("Line_below")])
