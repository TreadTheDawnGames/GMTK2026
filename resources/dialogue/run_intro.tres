[gd_resource type="Resource" script_class="DialogueConversation" load_steps=7 format=3 uid="uid://dt1ue7jav8nj4"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_old_miner"]
script = ExtResource("2_participant")
slot = &"old_miner"
display_name = "Old Miner"

[sub_resource type="Resource" id="Line_warning"]
script = ExtResource("3_line")
speaker_slot = &"old_miner"
text = "Bro why are you here? Whatever, you going after the Thief before he steals?"

[sub_resource type="Resource" id="Line_accept"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "Yup!!"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"run_intro"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_old_miner")])
lines = Array[ExtResource("3_line")]([SubResource("Line_warning"), SubResource("Line_accept")])
