[sub_resource type="Resource" id="Line_cheese"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "The shop will have to wait. I'm heading back up."

[sub_resource type="Resource" id="Line_treasure"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "I found what I came for. I'm finally going home."

[sub_resource type="Resource" id="Line_rutini"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "Come on, crew! Last rat out buys the cheese!"

[sub_resource type="Resource" id="Line_teen"]
script = ExtResource("3_line")
speaker_slot = &"moody_teen"
text = "..."

[sub_resource type="Resource" id="Line_coffee"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
text = "ONE LAST COFFEE!!!"

[sub_resource type="Resource" id="Line_cloak"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "I'm the last one. Keep digging and you won't meet anyone else."

[sub_resource type="Resource" id="Line_miles"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "Only miles of stone remain between you and the Thief. I can't stop you, but it is a fool's errand."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cast_farewell"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cheese_girl"), SubResource("Participant_treasure_hunter"), SubResource("Participant_rutini"), SubResource("Participant_moody_teen"), SubResource("Participant_coffee_cat"), SubResource("Participant_cloak_lantern")])
lines = Array[ExtResource("3_line")]([SubResource("Line_cheese"), SubResource("Line_treasure"), SubResource("Line_rutini"), SubResource("Line_teen"), SubResource("Line_coffee"), SubResource("Line_cloak"), SubResource("Line_miles"), SubResource("Line_miner")])
