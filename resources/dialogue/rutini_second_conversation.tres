[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://b37tolurnfqhs"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_again"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "You again? Did you find the cheese cafe? We seem to have gotten lost in our own tunnels."

[sub_resource type="Resource" id="Line_miner_one"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_cafe"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "IT’S STRAIGHT DOWN!? Why didn’t you say so earlier?"

[sub_resource type="Resource" id="Line_later"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
stage_cue = &"begin_colony_mining"
text = "Come on boys! Dig!"

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_rutini"]
script = ExtResource("2_participant")
slot = &"rutini"
display_name = "Rotini"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"rutini_second"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_rutini")])
lines = Array[ExtResource("3_line")]([SubResource("Line_again"), SubResource("Line_miner_one"), SubResource("Line_cafe"), SubResource("Line_later")])
