[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_rutini"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "Easy, lads. We're here."

[sub_resource type="Resource" id="Line_cheese"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "You found it! I knew you would."

[sub_resource type="Resource" id="Line_treasure"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "No treasure here. Good. I was tired of carrying things."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "…"

[sub_resource type="Resource" id="Line_treasure_elevator"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "What do you mean how did I get here? You didn’t take the elevator?"

[sub_resource type="Resource" id="Line_coffee"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"hold_cup"
text = "C-C-CAFE COFFEE! WE MADE IT! DID WE MAKE IT FAST? I THINK WE MADE IT FAST!"

[sub_resource type="Resource" id="Line_cloak"]
script = ExtResource("3_line")
speaker_slot = &"cloak_lantern"
text = "Stay a while. Not every minute needs somewhere to go."

[sub_resource type="Resource" id="Line_miner_final"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cheese_girl"]
script = ExtResource("2_participant")
slot = &"cheese_girl"
display_name = "Cheese Girl"

[sub_resource type="Resource" id="Participant_treasure_hunter"]
script = ExtResource("2_participant")
slot = &"treasure_hunter"
display_name = "Treasure Hunter"

[sub_resource type="Resource" id="Participant_rutini"]
script = ExtResource("2_participant")
slot = &"rutini"
display_name = "Rotini"

[sub_resource type="Resource" id="Participant_coffee_cat"]
script = ExtResource("2_participant")
slot = &"coffee_cat"
display_name = "Quibble"

[sub_resource type="Resource" id="Participant_cloak_lantern"]
script = ExtResource("2_participant")
slot = &"cloak_lantern"
display_name = "Lantern Keeper"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cafe_gathering"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cheese_girl"), SubResource("Participant_treasure_hunter"), SubResource("Participant_rutini"), SubResource("Participant_coffee_cat"), SubResource("Participant_cloak_lantern")])
lines = Array[ExtResource("3_line")]([SubResource("Line_rutini"), SubResource("Line_cheese"), SubResource("Line_treasure"), SubResource("Line_miner"), SubResource("Line_treasure_elevator"), SubResource("Line_coffee"), SubResource("Line_cloak"), SubResource("Line_miner_final")])
