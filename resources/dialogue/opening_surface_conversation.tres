[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_return"]
script = ExtResource("3_line")
speaker_slot = &"opening_voice"
text = "You’re back?"

[sub_resource type="Resource" id="Line_thief"]
script = ExtResource("3_line")
speaker_slot = &"opening_voice"
text = "You already know the Thief lies below."

[sub_resource type="Resource" id="Line_fools_one"]
script = ExtResource("3_line")
speaker_slot = &"opening_voice"
text = "Only fools find him."

[sub_resource type="Resource" id="Line_fools_two"]
script = ExtResource("3_line")
speaker_slot = &"opening_voice"
text = "Only fools."

[sub_resource type="Resource" id="Participant_opening_voice"]
script = ExtResource("2_participant")
slot = &"opening_voice"
display_name = "..."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"opening_surface"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_opening_voice")])
lines = Array[ExtResource("3_line")]([SubResource("Line_return"), SubResource("Line_thief"), SubResource("Line_fools_one"), SubResource("Line_fools_two")])
