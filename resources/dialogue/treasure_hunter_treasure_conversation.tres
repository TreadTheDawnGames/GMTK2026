[gd_resource type="Resource" script_class="DialogueConversation" load_steps=11 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_treasure_hunter"]
script = ExtResource("2_participant")
slot = &"treasure_hunter"
display_name = "Treasure Hunter"

[sub_resource type="Resource" id="Line_cheer"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Yippee! Wahoo!"

[sub_resource type="Resource" id="Line_found"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "I've found it! The legends were true!"

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_wish"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "I hope you find what you're looking for!"

[sub_resource type="Resource" id="Line_pickaxe"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Here, I won't be needing this old pickaxe anymore. You take it."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"treasure_hunter_treasure"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_treasure_hunter")])
lines = Array[ExtResource("3_line")]([SubResource("Line_cheer"), SubResource("Line_found"), SubResource("Line_miner"), SubResource("Line_wish"), SubResource("Line_pickaxe")])
