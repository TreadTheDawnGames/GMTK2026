[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://yigtckpqgod"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_whoop"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Yippee! Wahoo!"

[sub_resource type="Resource" id="Line_cheer"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "I found it. More treasure than I could ever carry."

[sub_resource type="Resource" id="Line_found"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "Everyone told me I was wasting my time, but it’s not like any of them were even trying."

[sub_resource type="Resource" id="Line_finally"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "It’s finally mine! I spent so long wondering what it would look like."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_wish"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
text = "It's mostly just heavy."

[sub_resource type="Resource" id="Line_pickaxe"]
script = ExtResource("3_line")
speaker_slot = &"treasure_hunter"
speaker_pose = &"no_pickaxe"
text = "Take this. I don't need to dig anymore."

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_treasure_hunter"]
script = ExtResource("2_participant")
slot = &"treasure_hunter"
display_name = "Treasure Hunter"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"treasure_hunter_treasure"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_treasure_hunter")])
lines = Array[ExtResource("3_line")]([SubResource("Line_whoop"), SubResource("Line_cheer"), SubResource("Line_found"), SubResource("Line_finally"), SubResource("Line_miner"), SubResource("Line_wish"), SubResource("Line_pickaxe")])
