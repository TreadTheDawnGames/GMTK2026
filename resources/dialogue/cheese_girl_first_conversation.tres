[gd_resource type="Resource" script_class="DialogueConversation" load_steps=10 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cheese_girl"]
script = ExtResource("2_participant")
slot = &"cheese_girl"
display_name = "Cheese Girl"

[sub_resource type="Resource" id="Line_boxes"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Oh, I'm sorry! I'm moving these boxes of cheese to my shop. It'll be open again soon, I promise!"

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_thief"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "You're on your way to the Thief? Then you'll pass my shop at depth 850,000."

[sub_resource type="Resource" id="Line_cafe"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Maybe I'll see you there. The Cheese Café has the best cheese in all the land!"

[sub_resource type="Resource" id="Line_gift"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Take this spare pickaxe from the delivery crate. It'll get you moving."

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cheese_girl_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cheese_girl")])
lines = Array[ExtResource("3_line")]([SubResource("Line_boxes"), SubResource("Line_miner"), SubResource("Line_thief"), SubResource("Line_cafe"), SubResource("Line_gift")])
