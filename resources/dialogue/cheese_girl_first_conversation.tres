[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://5yfnr66jrk50"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_intro"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Hi! I'm Cheese Girl. I'm taking these boxes down to the Cheese Cafe."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_thief"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "The cafe is straight down, near depth 14,000. You can't miss it!"

[sub_resource type="Resource" id="Line_cafe"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Maybe I'll see you there. The Cheese Café has the best cheese in all the land!"

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cheese_girl"]
script = ExtResource("2_participant")
slot = &"cheese_girl"
display_name = "Cheese Girl"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cheese_girl_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cheese_girl")])
lines = Array[ExtResource("3_line")]([SubResource("Line_intro"), SubResource("Line_miner"), SubResource("Line_thief"), SubResource("Line_cafe")])
