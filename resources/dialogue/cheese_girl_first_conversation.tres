[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_intro"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Mister Man? Are you ok?"

[sub_resource type="Resource" id="Line_invitation"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "…"

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Wiw you pwease come to my cheese Cafe?"

[sub_resource type="Resource" id="Line_thief"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "Buissiness is booming!  And I’m sure you wiw find it delightfuw to visit."

[sub_resource type="Resource" id="Line_cafe"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "…"

[sub_resource type="Resource" id="Line_goodbye"]
script = ExtResource("3_line")
speaker_slot = &"cheese_girl"
text = "See you soon bye!"

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_cheese_girl"]
script = ExtResource("2_participant")
slot = &"cheese_girl"
display_name = "Cheese Girl"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"cheese_girl_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_cheese_girl")])
lines = Array[ExtResource("3_line")]([SubResource("Line_intro"), SubResource("Line_invitation"), SubResource("Line_miner"), SubResource("Line_thief"), SubResource("Line_cafe"), SubResource("Line_goodbye")])
