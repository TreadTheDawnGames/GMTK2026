[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://dtm0e1l3tldo4"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_path"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "Whoa! Sorry to break it to you, but this path is in use."

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_intro"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "I'm Rotini. My colony and I are looking for a good route through these caves."

[sub_resource type="Resource" id="Line_crew"]
script = ExtResource("3_line")
speaker_slot = &"rutini"
text = "Come on, colony! We'll find our way."

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_rutini"]
script = ExtResource("2_participant")
slot = &"rutini"
display_name = "Rotini"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"rutini_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_rutini")])
lines = Array[ExtResource("3_line")]([SubResource("Line_path"), SubResource("Line_miner"), SubResource("Line_intro"), SubResource("Line_crew")])
