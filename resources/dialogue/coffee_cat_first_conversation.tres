[gd_resource type="Resource" script_class="DialogueConversation" load_steps=11 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_coffee_cat"]
script = ExtResource("2_participant")
slot = &"coffee_cat"
display_name = "Quibble"

[sub_resource type="Resource" id="Line_coffee"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "COFFEE!!!"

[sub_resource type="Resource" id="Line_chug"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"drink"
text = "(Quibble chugs an entire cup.)"

[sub_resource type="Resource" id="Line_enough"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "I'm Quibble! I'm heading straight down to the Cheese Cafe for more coffee!"

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_coffee_gift"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"hold_cup"
text = "Take a cup for the road! This coffee will make you move faster!"

[sub_resource type="Resource" id="Line_go"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "Now let's get to that cafe!"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"coffee_cat_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_coffee_cat")])
lines = Array[ExtResource("3_line")]([SubResource("Line_coffee"), SubResource("Line_chug"), SubResource("Line_enough"), SubResource("Line_miner"), SubResource("Line_coffee_gift"), SubResource("Line_go")])
