[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://bpovruhocqc5"]

[ext_resource type="Script" uid="uid://c55utdbjdwaui" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://ivfntthetp0i" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" uid="uid://bwwpoalvqb7ni" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_coffee"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "I'm Quib-Quib-Quib-Quib-Quibble!"

[sub_resource type="Resource" id="Line_enough"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "Have you seen seen seen the cafe? Cafe? Coffee? Coffee cafe?"

[sub_resource type="Resource" id="Line_miner"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_chug"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"drink"
text = "(Quibble rapidly finishes another cup.)"

[sub_resource type="Resource" id="Line_coffee_gift"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"hold_cup"
text = "This is is is travel coffee. T-t-take it."

[sub_resource type="Resource" id="Line_go"]
script = ExtResource("3_line")
speaker_slot = &"coffee_cat"
speaker_pose = &"idle"
text = "It makes ev-ev-ev-ev-erything go f-f-faster!"

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_coffee_cat"]
script = ExtResource("2_participant")
slot = &"coffee_cat"
display_name = "Quibble"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"coffee_cat_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_coffee_cat")])
lines = Array[ExtResource("3_line")]([SubResource("Line_coffee"), SubResource("Line_enough"), SubResource("Line_miner"), SubResource("Line_chug"), SubResource("Line_coffee_gift"), SubResource("Line_go")])
