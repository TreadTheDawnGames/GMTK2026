[gd_resource type="Resource" script_class="DialogueConversation" load_steps=13 format=3]

[ext_resource type="Script" path="res://resources/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_participant.gd" id="2_participant"]
[ext_resource type="Script" path="res://resources/dialogue/dialogue_line.gd" id="3_line"]

[sub_resource type="Resource" id="Participant_miner"]
script = ExtResource("2_participant")
slot = &"miner"
display_name = "Miner"

[sub_resource type="Resource" id="Participant_moody_teen"]
script = ExtResource("2_participant")
slot = &"moody_teen"
display_name = "Moody Teen"

[sub_resource type="Resource" id="Line_one"]
script = ExtResource("3_line")
speaker_slot = &"moody_teen"
text = "..."

[sub_resource type="Resource" id="Line_miner_one"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_two"]
script = ExtResource("3_line")
speaker_slot = &"moody_teen"
text = ". . ."

[sub_resource type="Resource" id="Line_miner_two"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_three"]
script = ExtResource("3_line")
speaker_slot = &"moody_teen"
text = ".  .  ."

[sub_resource type="Resource" id="Line_miner_three"]
script = ExtResource("3_line")
speaker_slot = &"miner"
text = "..."

[sub_resource type="Resource" id="Line_gift"]
script = ExtResource("3_line")
speaker_slot = &"moody_teen"
text = "(He silently slides a lantern pickaxe across the floor.)"

[resource]
script = ExtResource("1_conversation")
conversation_id = &"moody_teen_first"
participants = Array[ExtResource("2_participant")]([SubResource("Participant_miner"), SubResource("Participant_moody_teen")])
lines = Array[ExtResource("3_line")]([SubResource("Line_one"), SubResource("Line_miner_one"), SubResource("Line_two"), SubResource("Line_miner_two"), SubResource("Line_three"), SubResource("Line_miner_three"), SubResource("Line_gift")])
