[sub_resource type="Resource" id="Beat_frame_moody_teen"]
script = ExtResource("1_beat")
kind = 11
start_seconds = 20.5
duration_seconds = 0.85
camera_offset = Vector2(195, 55)
camera_zoom = Vector2(1.6, 1.6)
notes = "Continues the right-to-left pass from Quibble to Moody Teen behind the dining set. The 0.85-second sine-eased move lands before his ellipsis, keeping the background chair and table visible as the depth cue that identifies Eve's composition."

[sub_resource type="Resource" id="Beat_moody_teen_dialogue"]
script = ExtResource("1_beat")
kind = 5
start_seconds = 21.35
duration_seconds = 1.5
conversation = ExtResource("2_conversation")
line_range = Vector2i(6, 6)
notes = "Moody Teen's entire cafe contribution is the requested silent ellipsis. His run-wide presenter receives the same speech bounce callback as every other gathered cast member."

[sub_resource type="Resource" id="Beat_frame_keeper"]
script = ExtResource("1_beat")
kind = 11
start_seconds = 22.85
duration_seconds = 2.4
camera_offset = Vector2(-350, 60)
camera_zoom = Vector2(1.5, 1.5)
notes = "The longest smooth CAMERA/FRAME move continues from Moody Teen behind the right-middle dining set to the far-left Lantern Keeper, completing Zephan's right-to-left direction. It blocks before his line, so he cannot speak until the camera has found him."

[sub_resource type="Resource" id="Beat_keeper_dialogue"]
script = ExtResource("1_beat")
kind = 5
start_seconds = 25.25
duration_seconds = 3.0
conversation = ExtResource("2_conversation")
line_range = Vector2i(7, 7)
notes = "The Lantern Keeper alone, after the right-to-left world pan has landed on him. The canonical wording ships unchanged; Zephan's shorter alternate still needs a narrative ruling."

[sub_resource type="Resource" id="Beat_miner_reaction"]
script = ExtResource("1_beat")
kind = 5
start_seconds = 28.25
duration_seconds = 1.5
conversation = ExtResource("2_conversation")
line_range = Vector2i(8, 8)
notes = "The Miner's final silence is a reaction, not another spoken thought, so the Keeper remains the last character to say a line. The tableau framing already keeps both visible and therefore does not cut or snap for the ellipsis."

[sub_resource type="Resource" id="Beat_closing_hold"]
script = ExtResource("1_beat")
start_seconds = 29.75
duration_seconds = 0.8
notes = "A held beat on the Keeper after the miner's reaction. Without it the shot cuts straight from the dialogue box closing into the zoom out, and 'Stay a while. Not every minute needs somewhere to go.' does not get the moment it is asking for."

[sub_resource type="Resource" id="Beat_reset_camera"]
script = ExtResource("1_beat")
kind = 11
start_seconds = 30.55
duration_seconds = 1.8
camera_action = 2
notes = "The typed CAMERA/RESET handback. It eases offset and zoom together from the Keeper close-up to the encounter's neutral frame, revealing the whole gathering before play_closing fades the Keeper and MiningCinematicFlow returns control.

This is deliberately the last timeline beat. Shared flow release then applies Encounter 9's small authored recession; nobody else leaves, because review mode should find the gathering still at the cafe."

