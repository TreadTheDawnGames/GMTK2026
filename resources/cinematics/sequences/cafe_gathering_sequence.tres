kind = 2
actor = &"rutini"
facing = -1
notes = "Looking left from his table toward the Miner. The cafe is immediately behind him on the right, exactly as Zephan's paper arrangement places it."

[sub_resource type="Resource" id="Beat_show_coffee_cat"]
script = ExtResource("1_beat")
kind = 9
actor = &"coffee_cat"

[sub_resource type="Resource" id="Beat_pose_coffee_cat"]
script = ExtResource("1_beat")
kind = 1
actor = &"coffee_cat"
pose = &"hold_cup"
holds_pose = true
notes = "He arrives already holding one. His own line in the conversation carries the same pose in its Speaker Pose field, so this is what he is doing before he says anything rather than something he starts doing in order to say it."

[sub_resource type="Resource" id="Beat_face_coffee_cat"]
script = ExtResource("1_beat")
kind = 2
actor = &"coffee_cat"
facing = -1
notes = "Looking left from the cafe window toward the rest of the gathering. Quibble remains seated on the right serving-window stool."

[sub_resource type="Resource" id="Beat_show_cloak_lantern"]
script = ExtResource("1_beat")
kind = 9
actor = &"cloak_lantern"

[sub_resource type="Resource" id="Beat_face_cloak_lantern"]
script = ExtResource("1_beat")
kind = 2
actor = &"cloak_lantern"
facing = 1
notes = "Looking right across the whole gathering from the far-left edge. He remains apart from the cafe, but his last line is addressed toward everyone rather than out into empty rock."

[sub_resource type="Resource" id="Beat_show_moody_teen"]
script = ExtResource("1_beat")
kind = 9
actor = &"moody_teen"
notes = "Moody Teen is already standing in the rear dining-table lane when the Miner falls into the occupied cafe. DepthEncounterController reuses the presenter established by his scheduled cavern encounters, exactly like the other returning cast."

[sub_resource type="Resource" id="Beat_face_moody_teen"]
script = ExtResource("1_beat")
kind = 2
actor = &"moody_teen"
facing = -1
notes = "Looks left from behind the dining set toward the gathering. His Y 6 origin is behind the Y 36 furniture, so its lower screen position correctly occludes his lower silhouette."

[sub_resource type="Resource" id="Beat_open_silence"]
script = ExtResource("1_beat")
start_seconds = 1.0
duration_seconds = 0.6
notes = "Held silence on the cafe framing before anybody speaks. The miner has just come through the ceiling into the one place the entire run has been walking toward, and the shot needs a moment for the player to read the sign over his head before a dialogue box covers the bottom of the frame.

Longer than encounter 5's 0.6 on purpose. That shot had two people in it; this one has a building, four characters and a colony of rats, and it is worth the extra third of a second."

[sub_resource type="Resource" id="Beat_frame_cafe"]
script = ExtResource("1_beat")
kind = 11
duration_seconds = 1.0
camera_offset = Vector2(220, 40)
camera_zoom = Vector2(1.3, 1.3)
notes = "The opening typed CAMERA/FRAME beat establishes the occupied cafe before isolating speakers. Its positive Y offset lifts the extended 2.5D ground and every depth lane above the dialogue strip.

CutsceneActionPresenter owns the shared camera and view offset. No stage-local zoom signal or AnimationPlayer track duplicates that ownership."

[sub_resource type="Resource" id="Beat_frame_rutini"]
script = ExtResource("1_beat")
kind = 11
start_seconds = 1.6
duration_seconds = 0.75
camera_offset = Vector2(100, 75)
camera_zoom = Vector2(1.55, 1.55)
notes = "Smoothly closes from the cafe establishing frame onto Rotini at the separate perspective table. The ground remains in view below him and the move finishes before his bounce or line."

[sub_resource type="Resource" id="Beat_rutini_arrives"]
script = ExtResource("1_beat")
kind = 3
actor = &"rutini"
start_seconds = 2.35
duration_seconds = 0.3
bounce_count = 2
bounce_offset = Vector2(-2, -8)
notes = "Two bounces just before his first line, so 'Easy, lads. We're here.' reads as him calling the colony to a stop rather than as a reaction to his own dialogue box. He is the only one in the shot who is arriving - everybody else has been waiting - and this is the beat that says so.

Two rather than one because one bounce reads as a nod and two reads as somebody shouting over a crowd."

