[sub_resource type="Resource" id="Resource_show"]
script = ExtResource("1_g737l")
kind = 9
actor = &"treasure_hunter"
notes = "He is already here. The stage authors Entrance on the conversation stop, so this reveals him standing at his hoard rather than walking him in along a tunnel this room does not have."

[sub_resource type="Resource" id="Resource_face"]
script = ExtResource("1_g737l")
kind = 2
actor = &"treasure_hunter"
facing = -1

[sub_resource type="Resource" id="Resource_pose"]
script = ExtResource("1_g737l")
kind = 1
actor = &"treasure_hunter"
pose = &"idle"

[sub_resource type="Resource" id="Resource_celebrate"]
script = ExtResource("1_g737l")
kind = 3
actor = &"treasure_hunter"
duration_seconds = 0.9
bounce_count = 4
bounce_offset = Vector2(0, -9)
notes = "The whooping the reference puts before the room even opens - Zephan slides Yippee and wahoo! in beside the miner while he is still falling, and the audio under those two cards is five seconds of it. Nothing here can present a line the miner is not there for, so it lands as the frame opens instead: this bounce plays him celebrating for the first 0.9s and the conversation then opens on Yippee! Wahoo!, so the ceiling comes in on a man already mid-celebration rather than on a man waiting to be spoken to. Left sequential rather than overlapped because DialogueDirector bounces the speaker again on each presented line, and two bounces on one beat is a jitter nobody asked for."

[sub_resource type="Resource" id="Resource_dialogue"]
script = ExtResource("1_g737l")
kind = 5
start_seconds = 0.9
duration_seconds = 6.0
conversation = ExtResource("2_31prq")
notes = "Blocks, so the clock holds here for as long as the player takes to read. Six seconds is the nominal length only. He remains at the hoard for the whole exchange, then leaves in the no-pickaxe pose so his later cafe appearance has a visible departure."

[sub_resource type="Resource" id="Resource_leave"]
script = ExtResource("1_g737l")
kind = 0
actor = &"treasure_hunter"
start_seconds = 6.9
duration_seconds = 1.6
target_marker = &"Exit"
pose = &"no_pickaxe"
notes = "He has handed off the pickaxe and leaves the hoard before his later cafe appearance."

[sub_resource type="Resource" id="Resource_hide"]
script = ExtResource("1_g737l")
kind = 10
actor = &"treasure_hunter"
start_seconds = 8.5

[resource]
script = ExtResource("3_fftny")
sequence_id = &"treasure_hunter_treasure_sequence"
beats = Array[ExtResource("1_g737l")]([SubResource("Resource_show"), SubResource("Resource_face"), SubResource("Resource_pose"), SubResource("Resource_celebrate"), SubResource("Resource_dialogue"), SubResource("Resource_leave"), SubResource("Resource_hide")])
