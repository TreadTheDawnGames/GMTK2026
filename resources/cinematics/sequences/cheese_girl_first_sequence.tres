camera_offset = Vector2(48, 14)
camera_zoom = Vector2(1.4, 1.4)
notes = "The typed CAMERA/FRAME move closes onto the two speakers after Cheese Girl settles and before her first line. Cheese Girl stays on the rear floor plane while the Miner stands 28px nearer the camera, so the 48px horizontal and 14px vertical offsets centre their shared midpoint. The 1.40 zoom matches Encounter 9's conversational framing while preserving both grounded silhouettes and the cave around them."

[sub_resource type="Resource" id="Resource_a5exc"]
script = ExtResource("1_j0luq")
kind = 5
start_seconds = 2.1
duration_seconds = 6.0
conversation = ExtResource("2_1frda")
notes = "Bright and quick. She introduces herself unprompted, so she arrives already pleased to see him and bobs on the spot. The dialogue waits for the shared camera frame to finish, avoiding a zoom that competes with her first line."

[sub_resource type="Resource" id="Beat_reset_camera"]
script = ExtResource("1_j0luq")
kind = 11
start_seconds = 8.1
duration_seconds = 0.9
camera_action = 2
notes = "The typed CAMERA/RESET move restores neutral encounter framing after the final line and before Cheese Girl exits. Pan and zoom return together through CutsceneActionPresenter, and cancellation or encounter release still restores the same neutral state."

