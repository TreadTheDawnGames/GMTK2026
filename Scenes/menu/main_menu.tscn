[node name="MenuLayout" type="VBoxContainer" parent="." unique_id=642881323]
editor_description = "Inset clear of the letterbox. CinematicFrame's bars cover the first and last 0.14 of the viewport (about 91 px each at 648), so the top and bottom offsets keep every element inside the visible band while the menu is up."
