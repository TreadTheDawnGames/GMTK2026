[node name="MainMenu" type="Control" unique_id=633825169 node_paths=PackedStringArray("title_group", "subtitle_group", "button_group", "start_button", "options_button", "exit_button", "exit_confirmation", "status_label")]
editor_description = "Overlay for the live mining scene, not a scene of its own: the world behind it is the game staged at the surface, so there is deliberately no background rect here. Every element sits inside the cinematic letterbox, which is already closed while the menu is up. mouse_filter stays at Stop on this root so the shot underneath cannot be clicked."
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_ufr4i")
script = ExtResource("1_menu")
