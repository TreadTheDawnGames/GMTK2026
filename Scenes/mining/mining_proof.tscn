[node name="OpeningShotCamera" type="Node" parent="MiningScene/Systems" unique_id=1376521597 node_paths=PackedStringArray("camera", "arrival_sequence")]
editor_description = "Owns the shared camera's zoom for the title shot only. It holds the wide menu framing, then closes onto the arriving bus and hands the camera back at exactly zoom 1, which is the framing every authored gameplay coordinate is measured against. menu_zoom cannot go far below 0.75: terrain is 1536 px wide against a 1152 px viewport, so a wider shot pulls the world's own left and right edges into frame."
