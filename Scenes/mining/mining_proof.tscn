[node name="MinerRig" parent="MiningScene" unique_id=726963260 instance=ExtResource("7_miner_rig")]
editor_description = "No z_index override on purpose. MinerRig owns its draw order through its surface_draw_order and buried_draw_order exports: he starts in front of terrain layer one (z_index 2) while standing on the untouched surface, and the first landing below it hands him back to the buried order the rest of the run plays at."

[node name="RatColonyFollowers" parent="MiningScene" unique_id=1715886738 node_paths=PackedStringArray("follow_target") instance=ExtResource("62_rat_followers")]
follow_target = NodePath("../MinerRig")

[node name="CharacterLayer" type="Node2D" parent="MiningScene" unique_id=1096715694]
editor_description = "Encounter sets and persistent visitors draw above terrain Layer 1 so the authored 2.5D ground remains their visible support instead of cutting through them. DepthEncounterController temporarily raises this layer one additional step while a cutscene owns the frame, then restores this persistent encounter order. The extra gap above Layer 1 lets a stage use local z -1 for background set pieces without falling back into the terrain."
z_index = 4

