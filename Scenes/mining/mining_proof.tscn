[node name="GemOutcropField" type="Node2D" parent="MiningScene" unique_id=398064516 node_paths=PackedStringArray("terrain_manager", "terrain_renderer")]
editor_description = "Rarely leaves a drawn crystal jutting out of a stratum a hit just cut through, and stands authored ones for cutscenes. It builds one drawing shelf per stratum and sits after the terrain renderer, so each crystal is covered by the layers still standing in front of it."
script = ExtResource("58_gem_field")
terrain_manager = NodePath("../TerrainManager")
terrain_profile = ExtResource("33_layer_profile")
terrain_renderer = NodePath("../TerrainLayerRenderer")
gem_texture = ExtResource("59_gem_crystals")

[node name="SunlightWash" type="ColorRect" parent="MiningScene" unique_id=788445143]
editor_description = "Additive daylight pool under the sun. It draws over the terrain, which it shares a z_index with and is listed after, and under the miner at z_index 3. It used to draw over him as well, on the grounds that sunlight should touch the cast: but its underground half starts at full strength exactly on the ground line, and he is the one character who stands astride that line for the whole run, so it laid a hard warm band across him at the knees that read as the terrain showing through his legs. SurfacePresentation drives its horizon."
z_index = 2
material = SubResource("ShaderMaterial_sunlight_wash")
offset_right = 1152.0
offset_bottom = 648.0
mouse_filter = 2

