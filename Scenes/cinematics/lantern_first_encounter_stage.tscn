[node name="LanternFirstEncounterStage" unique_id=211847311 instance=ExtResource("1_stage")]
editor_description = "Story beat 3, depth 1,400: the player first meets the man with the lantern staff, who cryptically foreshadows the Thief, then steps off his ledge into the pit beneath it. He stands on the miner's LEFT here, on authored rock, which is why Conversation Tracks Miner is off - a ledge cannot slide to meet a landing column. That costs the constant spacing the cheese girl room has: he sits anywhere from 128px to 512px left of the miner depending where the fall left him. That is the open question on this room, not an oversight. The jagged end wall is on the miner's RIGHT, the cheese girl wall mirrored."
opening_move_seconds = 2.0
closing_move_seconds = 0.9
opening_step_height = 6.0
hide_actor_after_closing = true
closing_fade_seconds = 0.9

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Off the left end of the ledge and past the frame edge, so he walks in out of the dark rather than appearing on it. y is -64 because the ledge stands eight rows above the miner's ground, and every marker here is authored on the surface it is used from."
position = Vector2(-1000, -64)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "On the ledge, back from its lip, so there is rock under him for the whole conversation."
position = Vector2(-363, -26)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "The lip itself. He steps here before going over it."
position = Vector2(-377, -26)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-348, -18)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "Barely off his conversation mark, because he does not leave by walking. Closing Fade Seconds hops him once and fades him out where he stands, so the tiny move is only enough to keep the closing tween honest. He is gone by the time the frame closes; the shaft below him is scenery and a place for his staff to end up, not somewhere he is seen to fall."
position = Vector2(-392, -28)

[node name="LanternStaff" parent="PropMarkers" index="0" unique_id=2096771290 instance=ExtResource("6_staff")]
editor_description = "Standing in the floor at the dead centre of the shaft, 95 rows below the room - far under the bottom of the cutscene frame, so nothing of it is visible while he is still talking. The miner mines straight down past the shaft afterwards and meets it on the way by. Placed here rather than spawned: an encounter stage lives for the whole run, so the staff is simply already there when the player arrives."
position = Vector2(-445, 764)
scale = Vector2(0.2462, 0.2462)

