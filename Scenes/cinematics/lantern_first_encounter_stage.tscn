[node name="LanternFirstEncounterStage" unique_id=211847311 instance=ExtResource("1_stage")]
editor_description = "Story beat 3, depth 1,400: the player first meets the Lantern Keeper on an authored ledge over the shaft that holds his abandoned staff. Canon gives him a slow approach, so Entrance begins 56px farther out on the same supported overhang and opening walks him toward the miner before he judges them. The camera holds on the fall for 0.35s, eases 12 cells left to discover the Keeper and cavern volume, and returns during his single-hop fade. Conversation Tracks Miner stays off because this ledge and shaft are fixed terrain, not a cluster that can slide to meet the landing column. Jared restored the approved bench beside the Keeper; it stays through the meeting and fades with him during closing, while RESET restores it after cancellation or replay. Jared rejected the encounter-specific lit/trodden floor treatment after seeing it in the dialogue frame, so this room uses the standard cave layers only; this stage owns only its camera displacement and scene-local staging."
opening_move_seconds = 1.8
closing_move_seconds = 0.9
opening_step_height = 4.0
hide_actor_after_closing = true
closing_fade_seconds = 0.9
entrance_facing = 1
conversation_facing = 1
closing_facing = -1

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Column 145, the outer edge of the ledge ROOT, seven cells left of Conversation. Marker x maps to a room column as 214 + x/8: the stage is anchored at terrain centre plus DepthEncounterConfig.encounter_horizontal_offset_cells, which is 22. Runtime samples layer-one support at this x; y remains the ledge's authored -64px editor reference."
position = Vector2(-552, -64)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "Column 153, on the ledge ROOT, eight terrain rows above the miner's floor and turned back toward the player. The root is the only part of this overhang that seats him: the runtime scans up from the miner's landing row for the first opening and back down for rock, and over the thin tip that scan drops past the ledge to the shaft floor ninety rows below. Columns 145 to 158 are the standable span. The earlier -592 put him on column 140, out on the tip."
position = Vector2(-488, -64)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "The furthest out he can actually be seated, at the root's outer column 145, kept as the spot to aim any later beat that walks him toward the edge. The drawn tip continues past this, but nothing standing on it is held up."
position = Vector2(-552, -64)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-488, -64)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "His own mark: he does not leave by walking. Closing Fade Seconds hops him once and fades him out where he stands, and Closing Facing turns him back to the drop first."
position = Vector2(-488, -64)

[node name="LanternStaff" parent="PropMarkers" index="0" unique_id=2096771290 instance=ExtResource("6_staff")]
texture_filter = 1
editor_description = "Standing in the floor at the shaft centre, 95 rows below the room and far under the dialogue frame. The scene-local nearest filter keeps its linework sharp at this scale. Jared's requested 15px rightward adjustment moves the approved whole-sprite staff from x=-704 to x=-689; the shared source art has no separable lantern head and is not modified."
position = Vector2(-689, 764)
scale = Vector2(0.2462, 0.2462)

[node name="Bench" parent="PropMarkers" index="1" instance=ExtResource("7_bench")]
editor_description = "The approved Lantern Keeper bench composition, restored for the first meeting. It keeps a 112px character/bench clearance from his later warning scene, but sits on his LEFT rather than his right: he can only be seated on the ledge root at columns 145 to 158, and a bench 118px to his right would land on column 167, off the drawn ledge entirely. A prop takes its y as authored rather than being sampled, so the bench is free to stand on the drawn tip at column 139 where nothing could be seated. This room's ledge is directly authored rather than loose tunnel dressing, so the bench uses the ledge's exact -64px reference; visual capture confirms its feet are flush with the top of layer one. Closing fades its alpha with the Keeper over 0.9s, and RESET restores it for cancellation or replay."
position = Vector2(-600, -64)

