[node name="LanternFirstEncounterStage" unique_id=211847311 instance=ExtResource("1_stage")]
editor_description = "Story beat 3, depth 1,400: the player first meets the man with the lantern staff, who cryptically foreshadows the Thief. He arrives unhurried and leaves the same way, because the shot's job is to plant a warning the player cannot act on yet. His art is drawn looking left, so he holds the conversation on the miner's right; on the left he would deliver the warning with his back turned."
