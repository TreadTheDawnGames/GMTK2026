[node name="LanternFirstEncounterStage" unique_id=211847311 instance=ExtResource("1_stage")]
editor_description = "Story beat 3, depth 1,400: the player first meets the Lantern Keeper on an authored ledge over the shaft that holds his abandoned staff. Canon gives him a slow approach, so Entrance begins 56px farther out on the same supported overhang and opening walks him toward the miner before he judges them. The camera holds on the fall for 0.35s, eases 12 cells left to discover the Keeper and cavern volume, and returns during his single-hop fade. Conversation Tracks Miner stays off because this ledge and shaft are fixed terrain, not a cluster that can slide to meet the landing column. The reusable trodden-floor shader is selected by cloak_lantern_first_encounter.tres; this stage owns only its camera displacement and scene-local staging."
opening_move_seconds = 1.8
closing_move_seconds = 0.9
opening_step_height = 4.0
hide_actor_after_closing = true
closing_fade_seconds = 0.9
entrance_facing = 1
conversation_facing = 1
closing_facing = -1

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Seven terrain cells left of Conversation, on the fractured unsupported tip. Runtime samples layer-one support at this x; y remains the ledge's authored -64px editor reference."
position = Vector2(-648, -64)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "Near the tip of the overhang, eight terrain rows above the miner's floor and over open shaft. Runtime footing comes from the real layer-one ledge support at this x."
position = Vector2(-592, -64)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "The very end of the overhang, kept as the spot to aim any later beat that walks him out to the edge."
position = Vector2(-632, -64)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-592, -64)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "His own mark: he does not leave by walking. Closing Fade Seconds hops him once and fades him out where he stands, and Closing Facing turns him back to the drop first."
position = Vector2(-592, -64)

[node name="LanternStaff" parent="PropMarkers" index="0" unique_id=2096771290 instance=ExtResource("6_staff")]
texture_filter = 1
editor_description = "Standing in the floor at the shaft centre, 95 rows below the room and far under the dialogue frame. The scene-local nearest filter keeps its linework sharp at this scale. Jared's requested 15px rightward adjustment moves the approved whole-sprite staff from x=-704 to x=-689; the shared source art has no separable lantern head and is not modified."
position = Vector2(-689, 764)
scale = Vector2(0.2462, 0.2462)

