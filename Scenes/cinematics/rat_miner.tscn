[node name="RatMiner" type="Node2D" node_paths=PackedStringArray("animation_player", "visual_root", "strike_anchor", "actor_sprite", "actor_sprite_view", "speech_reaction", "ground_shadow")]
editor_description = "Reusable mouse actor. Default Appearance and the sequence's appearance list pair each color's resting and strike art. The shared cutscene depth-light material and contact shadow are scene-owned presentation: rank coordinators only set a normalized depth amount."
process_mode = 3
z_index = 16
script = ExtResource("1_rat")
animation_player = NodePath("AnimationPlayer")
visual_root = NodePath("SpeechRoot/VisualRoot")
strike_anchor = NodePath("SpeechRoot/VisualRoot/StrikeAnchor")
actor_sprite = NodePath("SpeechRoot/VisualRoot/SquashRoot/ActorSprite")
actor_sprite_view = NodePath("ActorSpriteView")
speech_reaction = NodePath("SpeechReaction")
ground_shadow = NodePath("GroundShadow")
default_appearance = ExtResource("4_default")
appearance_scale = 0.22

[node name="SpeechRoot" type="Node2D" parent="."]
editor_description = "Presentation-only speech bounce. Motion here composes with the actor animation below."

[node name="VisualRoot" type="Node2D" parent="SpeechRoot"]
editor_description = "Facing lives here: set_facing_direction owns the sign of this node's scale.x. Clips animate only its position and rotation, never its scale, or turning around would fight the squash."

[node name="SquashRoot" type="Node2D" parent="SpeechRoot/VisualRoot"]
editor_description = "Squash and stretch only. Its origin is the mouse's soles, so scaling keeps the feet planted instead of sinking or floating the body."

[node name="ActorSprite" type="Sprite2D" parent="SpeechRoot/VisualRoot/SquashRoot"]
editor_description = "Editor preview for the default brown appearance. Runtime appearance assignment preserves this canvas registration. Every mouse PNG is cropped to one shared 938x648 content box, so this offset is derived, not tuned: it puts the resting body's center on the actor root's x and its soles exactly on the root's y."
texture_filter = 4
material = SubResource("ShaderMaterial_depth_light")
position = Vector2(8.4, -19.5)
scale = Vector2(0.22, 0.22)
texture = ExtResource("3_idle")
flip_h = true

[node name="StrikeAnchor" type="Marker2D" parent="SpeechRoot/VisualRoot"]
editor_description = "Stable right-wall strike contact. Deliberately a sibling of SquashRoot so the reported contact point does not wobble with squash and stretch."
position = Vector2(48, 18)

[node name="ActorSpriteView" type="Node" parent="." node_paths=PackedStringArray("actor_sprite")]
editor_description = "Optional idle, walk, and strike sprite-sheet presentation. An unassigned pose set preserves the paired PNG appearance."
script = ExtResource("5_pose_view")
actor_sprite = NodePath("../SpeechRoot/VisualRoot/SquashRoot/ActorSprite")

[node name="SpeechReaction" type="Node" parent="." node_paths=PackedStringArray("visual_root")]
script = ExtResource("2_speech")
visual_root = NodePath("../SpeechRoot")

[node name="GroundShadow" type="Node2D" parent="." node_paths=PackedStringArray("measured_sprite")]
editor_description = "The generalized cutscene contact-shadow shader. Jump code counter-moves this node by the arc height, so it stays on the floor and fades while the mouse leaves it."
script = ExtResource("7_ground_shadow")
width_scale = 1.25
height_ratio = 0.26
fallback_width = 52.0
measured_sprite = NodePath("../SpeechRoot/VisualRoot/SquashRoot/ActorSprite")

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
editor_description = "Run, strike, jump, and land clips animate paired mouse art through stable presentation roots. Position and rotation ride VisualRoot; every scale key rides SquashRoot."
libraries/ = SubResource("AnimationLibrary_rat")
