clump_minimum_distance_pixels = 216.0
rank_scales = PackedFloat32Array(1.35, 1.3, 1.25, 1.2)
rank_draw_orders = PackedInt32Array(1, 0, -1, -2)
rank_tints = PackedColorArray(1, 1, 1, 1, 0.97, 0.96, 0.95, 1, 0.93, 0.92, 0.91, 1, 0.88, 0.87, 0.86, 1)
rank_vertical_offsets = PackedFloat32Array(40, 40, 40, 40)
rank_spacing_pixels = 86.0
miner_clearance_pixels = 132.0
max_visible_followers = 32
web_max_visible_followers = 16

[node name="Formation" type="Node2D" parent="." unique_id=1190155047]
editor_description = "Fixed thirty-two-actor growth bound. Index modulo four decides a rat's rank, so trimming the live count for web thins all four ranks evenly instead of deleting the back of the crowd."

