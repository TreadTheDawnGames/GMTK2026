z_index = -2
modulate = Color(0.62, 0.6, 0.58, 1)
position = Vector2(-398, -34)
scale = Vector2(0.07647, 0.07647)

[node name="FarStoolRight" parent="PropMarkers" index="9" instance=ExtResource("13_stool_flat")]
z_index = -2
modulate = Color(0.62, 0.6, 0.58, 1)
position = Vector2(-306, -34)
scale = Vector2(0.07647, 0.07647)

