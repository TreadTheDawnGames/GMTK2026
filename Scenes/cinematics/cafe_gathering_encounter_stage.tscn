[node name="CafeGatheringEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Story beat 10, depth 14,000: the cafe gathering. Cheese Girl, the Treasure Hunter, Rotini and the rats, and Quibble are together and happy, and the lantern-staff man foreshadows the importance of time management. This is the one encounter that gathers its whole cast, so it is authored as a room the miner arrives into rather than a visitor who walks up to him: the cast holds its own spread across the tunnel and nobody tracks his landing column."
opening_move_seconds = 2.0
closing_move_seconds = 2.4
opening_step_height = 5.0
hide_actor_after_closing = false
conversation_tracks_miner = false
conversation_root_offset_from_miner_x = 0.0
actors_drawn_into_set = Array[StringName]([&"cheese_girl"])

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "The lantern-staff man's approach. The rest of the cast is already standing when the miner breaks through."
position = Vector2(288, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "Authored rather than tracked, so the gathering keeps its shape wherever the miner lands."
position = Vector2(120, 0)

