editor_description = "The same mark as Conversation. Canonical story says the Keeper HAS gathered here, so he is already standing at the end of the room when the ceiling comes in - there is no approach to walk, and Opening Move Seconds only exists to keep a tween honest if the timeline is ever cleared."
position = Vector2(-15, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "The Lantern Keeper's stand, 244px right of the miner - one measured miner-width off Quibble, who is himself one off the miner. The authored x is where he lands for a dead-centre fall: the stage sits 22 cells right of the terrain centre, so the miner is at -176 here. Conversation Tracks Miner re-derives the whole root's shift from wherever this marker currently is, so the number is for reading the scene rather than for the result."
position = Vector2(-15, 0)

