[node name="TreasureHunterFirstEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Encounter 4, depth 4,000: the Treasure Hunter mines in through the side wall, introduces himself by complaining, and gives away the first improved pickaxe while insisting the treasure is still his. His art is drawn looking left, so he stays on the miner's right.

This is the first encounter driven by its authored timeline rather than by the exports below. Plays Authored Timeline is on for it, so treasure_hunter_first_sequence owns the shot from the wall strikes through to the end of the conversation. Do not tune the approach here - Opening Move Seconds and the opening pose/facing are dead on this stage, and the beat that replaced each of them is in the timeline.

The closing move is NOT dead. play_closing() runs whether or not a timeline drove the opening, so the walk out is still authored here, and the timeline deliberately stops at the dialogue rather than walking him to Exit as well - otherwise he is moved twice.

He keeps his pickaxe through this whole encounter. The no_pickaxe pose exists in his set but belongs to encounter 6, where he gives up digging for good; here he hands over a spare and goes straight back to work, so nothing in this shot may empty his hands.

The room is cut to match: a pocket with a wandering rock wall at each end and a bore through the right-hand one, which is the rock he comes through. See local_tests/carve_treasure_hunter_first_room.gd for the geometry and why each wall stands where it does."
opening_move_seconds = 1.0
closing_move_seconds = 1.8
opening_step_height = 9.0
hide_actor_after_closing = true
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 122.5

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Inside his own bore and 600px right of Conversation, which keeps him past the frame edge at every landing column: the frame is 1152 wide and centred on the miner, so anything under 480px would have him appear from nothing in open shot. The bore is open from column 244 to the room's right edge, so this mark is in air wherever the landing puts it."
position = Vector2(504, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "122.5px right of the miner, root to root: his body measures 86.5px and the miner's 52.8px, so this leaves exactly one miner-width of daylight between them."
position = Vector2(-96, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-96, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "Back into the bore he arrived through, 700px right of Conversation, so he is out of shot well before he is hidden. He leaves the way he came rather than walking past the miner."
position = Vector2(604, 0)

[node name="WallStrike" type="Marker2D" parent="ActionMarkers" index="0"]
editor_description = "Where the three STRIKE beats throw dirt, smoke and shake, through the shared presentation-strike bridge. Pinned to the rock rather than to the miner: ActionMarkers does not slide with the landing column the way ActorMarkers does, and the wall does not move.

x 248 is the bore mouth, terrain column 246, measured from this stage's own origin at column 214. y -48 is six cells above the floor line, which is chest height on him. Both stay inside the frame at every landing column, so the wall is always seen coming apart."
position = Vector2(248, -48)

