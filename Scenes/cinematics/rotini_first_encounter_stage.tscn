[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "600px right of Conversation, which puts both Rotini and every mouse past the frame edge at any landing column: the frame is 1152 wide and centred on the miner, so anything closer than 480px would have them appear from nothing in open shot. The colony spawns here too."
position = Vector2(504, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
position = Vector2(-96, 0)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "Unused while Procession Mines is off; the mice run straight from Entrance to Exit."
position = Vector2(0, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
