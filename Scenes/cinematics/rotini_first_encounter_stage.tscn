[node name="RotiniFirstEncounterStage" unique_id=1625704577 instance=ExtResource("1_stage")]
editor_description = "Story beat 4, depth 2,500: Rotini is introduced on the cave path. He is a rat and reads much smaller than the miner, so he comes in quickly and stands close; at the other visitors' spacing he would be a speck at the edge of the frame. His art is drawn looking left, so he stays on the miner's right. The rutini_* resource names refer to Rotini until a coordinated rename is approved."
opening_move_seconds = 0.9
closing_move_seconds = 1.4
opening_step_height = 3.0
hide_actor_after_closing = true
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 56.0

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Right of the miner and close in, because a rat crossing the full room reads as a long wait for very little movement."
