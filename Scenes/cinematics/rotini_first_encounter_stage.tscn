[node name="RotiniFirstEncounterStage" unique_id=1625704577 instance=ExtResource("1_stage")]
editor_description = "Story beat 4, depth 2,500: Rotini stops the miner on the cave path. The room is a level tunnel OPEN AT BOTH ENDS - no wall on either side - because the whole beat is traffic passing through it. The colony starts with the opening, so the mice are already streaming right to left when the frame opens and Rotini walks up out of them; he then tells the miner the path is taken and leaves with them to the LEFT. Inherits the rat colony stage rather than repeating it, with Procession Mines off: these mice are commuting, not digging. Spacing follows the house rule - his body measures 62.7px and the miner's 52.8px, so 110px root to root leaves one miner-width of daylight. The rutini_* resource names refer to Rotini until a coordinated rename is approved."
opening_move_seconds = 1.5
closing_move_seconds = 2.0
opening_step_height = 3.0
hide_actor_after_closing = true
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 110.0
procession_mines = false
spawn_interval_seconds = 0.3
exit_seconds = 2.0

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "600px right of Conversation, which puts both Rotini and every mouse past the frame edge at any landing column: the frame is 1152 wide and centred on the miner, so anything closer than 480px would have them appear from nothing in open shot. The colony spawns here too."
position = Vector2(504, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
position = Vector2(-96, 0)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "Unused while Procession Mines is off; the mice run straight from Entrance to Exit."
position = Vector2(0, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-96, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "LEFT, 700px clear of Conversation. Both the mice and Rotini leave this way - on toward the Cafe - rather than back where they came from. The colony reads the travel direction off Entrance and Exit, so putting the exit on this side is all that reverses the procession."
position = Vector2(-796, 0)

