[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "LEFT, 700px clear of Conversation. Both the mice and Rotini leave this way - on toward the Cafe - rather than back where they came from. The colony reads the travel direction off Entrance and Exit, so putting the exit on this side is all that reverses the procession."
position = Vector2(-796, 0)

[node name="RatContainer" parent="." index="3"]
editor_description = "Zero rather than the base scene's 7, so the colony lands on the SECOND layer with the rest of the cast instead of on top of every stratum.

The number is relative and the chain matters: DepthEncounterController puts CharacterLayer on cutscene_draw_order (1) for the shot, this container adds its own, and each mouse adds a row offset on top. At 7 the whole colony came out around 8 - in front of all four strata and of the miner - which is the first layer, not the second. At 0 the front row sits exactly where MinerRig.buried_draw_order stands him while he digs, and the rows behind recede from there."
z_index = 0

