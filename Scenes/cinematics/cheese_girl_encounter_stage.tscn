[node name="CheeseGirlEncounterStage" unique_id=206075300 instance=ExtResource("1_stage")]
editor_description = "Cheese Girl comes along the open right-hand cave, stops one miner-width clear of the miner's right, and walks back out that way on her way to the Cheese Cafe. The room closes behind the miner with a rounded irregular left wall built from overlapping cave volumes, rises around the full 49-column landing shaft, and pinches into an irregular right walk-off instead of repeating the procedural tunnel scallop. Its encounter resource opts into the shared trodden-floor shader used by the cafe, so both characters remain grounded on the shaded foreground surface without a scene-local renderer or character material. After she settles, the typed sequence camera eases to 1.40 zoom at the two-person midpoint, holds that close framing for the conversation, then resets before her exit in the same language as Encounter 9. The offset is root to root: his body measures 52.8px and hers 34.3px, so 96px leaves exactly one miner of daylight between them. Measure the widest opaque row, never the sprite bounding box, which unions his pickaxe head with his torso and reads about twice the man. Her art is drawn looking left, so she stays on his right for the whole visit; on his left she would hold the conversation with her back to him. Every actor marker here is authored relative to Conversation, because the whole set slides to the miner's landing column at runtime."
opening_move_seconds = 2.1
closing_move_seconds = 2.4
opening_step_height = 8.0
hide_actor_after_closing = true
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 96.0

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Right of the miner, so walking in never carries her across him. 600px right of Conversation, which is what puts her past the frame edge once the whole marker set slides to his landing column: the frame is 1152 wide and centred on him, so anything under 480px from Conversation would have her appear from nothing in open shot."
position = Vector2(504, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
position = Vector2(-96, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
position = Vector2(-96, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "Inside the room's right tunnel and 700px right of Conversation, which keeps her clear of the frame edge at every landing column, so she is out of shot well before she is hidden."
position = Vector2(604, 0)

