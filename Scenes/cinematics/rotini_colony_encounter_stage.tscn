[node name="RotiniColonyEncounterStage" unique_id=164779342 instance=ExtResource("1_stage")]
editor_description = "Encounter 8, Rotini and the Colony, depth 11,200. The mirror of his introduction: Rotini arrives from the LEFT and holds the conversation on the miner's LEFT. Nothing moves when the frame opens. On \"Come on boys! Dig!\", twenty-four normal-size individual mice flood into four depth lanes, take deterministic work roots across both halves of the floor, and start swinging without entering the miner's protected 132px center lane. Clump drawings are deliberately excluded: the colony's density comes from readable individual mice, overlap, lighting, shadows and lane depth. Arrival facing and the approach belong to rutini_second_sequence; only the closing walk is authored here. The rutini_* resource names refer to Rotini until a coordinated rename is approved."
rat_appearances = Array[ExtResource("6_rat_appearance")]([ExtResource("8_brown"), ExtResource("9_grey"), ExtResource("10_white"), ExtResource("8_brown"), ExtResource("9_grey"), ExtResource("10_white")])
max_live_followers = 24
web_max_live_followers = 16
spawn_interval_seconds = 0.1
run_seconds = 1.15
exit_seconds = 1.2
strike_interval_seconds = 0.08
strikes_per_rat = 4
floor_offset_y = 0.0
procession_mines = true
procession_cue = &"begin_colony_mining"
stampede_warning_seconds = 0.0
stampede_rumble_strength_px = 5.0
stampede_minimum_run_seconds = 4.0
stampede_drain_timeout_seconds = 6.0
clump_draw_order = -1
single_draw_order = 0
clump_scale_multiplier = 1.0
single_scale_multiplier = 1.35
procession_rows = 4
procession_row_rise_pixels = 18.0
procession_row_scale_falloff = 0.96
procession_hop_pixels = 24.0
mining_floor_half_span_pixels = 520.0
mining_center_clearance_pixels = 132.0
mining_slot_spacing_pixels = 96.0
closing_move_seconds = 1.6
hide_actor_after_closing = true
entrance_facing = 1
closing_facing = 1
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = -110.0

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "600px LEFT of Conversation, which puts Rotini and every mouse past the frame edge at any landing column: the frame is 1152 wide and centred on the miner, so anything closer than 480px would have them appear out of nothing in open shot. The colony spawns here too, so the flood comes in behind him rather than past him."
position = Vector2(-504, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "110px LEFT of the miner, root to root, so one miner-width of daylight sits between their facing edges. He is on the miner's left this time, and his art rests mirrored, so the timeline turns him to face RIGHT to look at the man he is talking to. Tracking slides the whole marker set here, so the shot is the same whichever column the descent arrived down."
position = Vector2(96, 0)

[node name="Work" parent="ActorMarkers" index="2"]
editor_description = "The miner's column. RatColonyEncounterStage expands deterministic work slots from here across both halves of the floor, keeping Mining Center Clearance empty so neither Rotini nor a mouse covers the player."
position = Vector2(206, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
editor_description = "Unused: hide_actor_after_closing sends him to Exit instead. Kept on the conversation stop so that turning that flag off for a test leaves him where he was standing rather than somewhere arbitrary."
position = Vector2(96, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "RIGHT, 700px clear of Conversation. Both the mice and Rotini leave this way - onward and down, the direction he has just been told the Cafe is - rather than back where they came from. The colony reads its travel direction off Entrance and Exit, so putting the exit on this side is all that reverses the procession from his introduction."
position = Vector2(796, 0)

