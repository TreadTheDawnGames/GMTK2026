[node name="TreasureHunterHoardEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Encounter 6, The Treasure. The Treasure Hunter is already standing at the hoard he spent years looking for when the miner breaks through, so he does not walk in: he is found here, gives away his pickaxe, then leaves for the later cafe gathering. Reading left to right the shot is miner, then him, then the treasure heaped up behind him and running on past the frame edge - he is between the two, turned back to the miner, gloating over riches that are at his shoulder rather than across the room. His art is drawn facing left, which is why he holds the whole conversation on the miner's right. Every marker and the hoard itself are authored relative to Conversation and slide to the miner's landing column together, so this composition is identical whichever of the 49 columns the descent arrived down."
opening_move_seconds = 0.6
closing_move_seconds = 0.6
closing_pose = &"no_pickaxe"
rest_pose = &"no_pickaxe"
hide_actor_after_closing = true
conversation_facing = -1
closing_facing = -1
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 150.0
props_track_tracked_cast = true

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "On the conversation stop, not off screen. He is not a visitor arriving; the room is his find and he is in it when the ceiling breaks. prepare() places him here, so an entrance anywhere else would make him walk in from a tunnel the reference does not have."
position = Vector2(150, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "150px right of the miner, root to root, a little over the measured 122.5px house spacing for him. His body is 86.5px and the miner's 52.8px, so their facing edges are 81px apart and the hoard's toe is a further 47px past his shoulder: he stands clear of both rather than being crowded against either."
position = Vector2(150, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
editor_description = "The conversation stop. He gives the pickaxe away here before leaving for the later cafe gathering."
position = Vector2(150, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "Past the frame edge. The authored sequence sends him here in his no-pickaxe pose before hiding him."
position = Vector2(840, 0)

[node name="GemPile" type="Node2D" parent="PropMarkers" index="0"]
z_index = -1
editor_description = "A fixed 65-crystal hoard: 62 stacked in six overlapping courses from 242 to 607, and three spilled at the toe beside the Treasure Hunter. It is deliberately lopsided - a short steep face on his side and a long tail running past the right edge of a 1152px frame - so what the player sees is the near end of something bigger, not a pile that happens to stop. The count is authored and bounded, and nothing adds to it at runtime. Two things about the order matter. Courses are authored back to front, so the near face of the heap draws over the one behind it - authored the other way round, as it was, the apex overlaps the base and the pile reads as a lattice of separate floating crystals rather than as a mound. And the horizontal step is 24px against a 29px crystal, so neighbours overlap; any step wider than the crystal leaves daylight between them and the same lattice comes back. The pile runs off the right of frame on purpose: what is in shot is its near end, not the whole of it."

