[node name="TreasureHunterHoardEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Encounter 6, The Treasure. The Treasure Hunter is already standing at the hoard he spent years looking for when the miner breaks through, so nobody walks in and nobody walks out: he is found here and he stays here. The miner arrives on the left, the hoard heaps up in the floor between them, and he stands just past its far toe looking back down the room over the top of it. His art is drawn facing left, which is why he holds the whole conversation on the miner's right. The 430px root-to-root gap is deliberately wider than the measured 122.5px house spacing for him, because the treasure has to fit in the gap and still read as treasure. Every marker and the hoard itself are authored relative to Conversation and slide to the miner's landing column together."
opening_move_seconds = 0.6
closing_move_seconds = 0.6
closing_pose = &"no_pickaxe"
rest_pose = &"no_pickaxe"
conversation_facing = -1
closing_facing = -1
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 430.0
props_track_tracked_cast = true

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "On the conversation stop, not off screen. He is not a visitor arriving; the room is his find and he is in it when the ceiling breaks. prepare() places him here, so an entrance anywhere else would make him walk in from a tunnel the reference does not have."
position = Vector2(430, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "430px right of the miner, root to root. His measured body is 86.5px and the miner's 52.8px, so their facing edges are 361px apart, and the hoard's base runs from 100 to 403. The treasure therefore fills the gap and he stands just past its far toe, which is the arrangement the reference draws: the miner is looking past the pile to reach him. Tracking holds this constant, so the shot is the same whichever column the descent arrived down."
position = Vector2(430, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
editor_description = "The conversation stop. He gives the pickaxe away and stays with the treasure, so the closing move has nowhere to take him."
position = Vector2(430, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "Unused. Nothing in this encounter sends him here - hide_actor_after_closing is off - but it is kept past the frame edge so that turning that flag on for a test cannot strand him in shot."
position = Vector2(840, 0)

[node name="GemPile" type="Node2D" parent="PropMarkers" index="0"]
z_index = -1
editor_description = "A fixed 54-crystal hoard: 51 stacked in six overlapping courses and three spilled at the toe on the miner's side. The count is authored and bounded, and nothing adds to it at runtime. Two things about the order matter. Courses are authored back to front, so the near face of the heap draws over the one behind it - authored the other way round, as it was, the apex overlaps the base and the pile reads as a lattice of separate floating crystals rather than as a mound. And the horizontal step is 24px against a 29px crystal, so neighbours overlap; any step wider than the crystal leaves daylight between them and the same lattice comes back."
