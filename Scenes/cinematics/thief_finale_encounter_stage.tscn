[node name="EditorTerrainPreview" parent="." index="4"]
editor_description = "Previews thief_finale at its real depth. This used to say 1000, left from when the schedule and the story disagreed about where this encounter lived. The encounter resolves at the run bottom and mining_config.tres puts that at 100,000, so that is what the preview has to draw or the rock is the wrong colour."
encounter_id = &"thief_finale"
preview_depth_rows = 100000

