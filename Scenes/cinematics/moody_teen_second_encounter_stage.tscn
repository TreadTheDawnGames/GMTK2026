[node name="MoodyTeenSecondEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Encounter 7.5, depth 10,500: the miner drops through a narrow throat into an asymmetric bell cavern and discovers Ayden already standing one measured miner-width to the right. The still seven-line exchange deliberately repeats Encounter 4.5, but the chamber reads vertically rather than as a broad horizontal arch. Every actor marker remains one grounded point, and closing leaves Ayden in place when mining control returns."
opening_move_seconds = 0.01
closing_move_seconds = 0.01
opening_step_height = 0.0
opening_pose = &"idle"
closing_pose = &"idle"
hide_actor_after_closing = false
entrance_facing = -1
conversation_facing = -1
closing_facing = -1
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 132.8

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Ayden is visible below the entry throat before the miner settles. The 2.25px authored fallback seats his opted-in sole overlap while the floor is still outside the renderer's support window; stage preparation replaces this y with the live terrain sample."
position = Vector2(-43.2, 2.25)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "132.8px right of the miner: the approved one-miner-width stare spacing."
position = Vector2(-43.2, 0)

[node name="Work" parent="ActorMarkers" index="2"]
position = Vector2(-43.2, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
editor_description = "Ayden remains in the bell chamber after the repeated exchange."
position = Vector2(-43.2, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "There is no exit choreography; closing resolves at the same grounded mark."
position = Vector2(-43.2, 0)

