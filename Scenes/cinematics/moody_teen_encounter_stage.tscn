[node name="MoodyTeenEncounterStage" instance=ExtResource("1_stage")]
editor_description = "Encounter 4.5, depth 5,000: the miner breaks into a broad cavern and discovers the Moody Teen already standing one measured miner-width to the right. Neither character approaches, gestures, departs, or changes pose; the entire joke is the long alternating stare. The authored timeline reveals him during the fall, holds the two-shot, and owns the seven-line conversation. Every actor marker is therefore the same grounded point, and closing leaves him in place when mining control returns. The production terrain preview supplies the real four depth strata; Dresses Trodden Floor on the encounter opts into the same shared ground treatment as Encounter 9."
opening_move_seconds = 0.01
closing_move_seconds = 0.01
opening_step_height = 0.0
opening_pose = &"idle"
closing_pose = &"idle"
hide_actor_after_closing = false
entrance_facing = -1
conversation_facing = -1
closing_facing = -1
conversation_tracks_miner = true
conversation_root_offset_from_miner_x = 132.8

[node name="Entrance" parent="ActorMarkers" index="0"]
editor_description = "Same grounded mark as every other phase. The Teen is already here when the ceiling breaks."
position = Vector2(-43.2, 0)

[node name="Conversation" parent="ActorMarkers" index="1"]
editor_description = "132.8px right of a dead-centre miner at -176: one measured miner-width of stare-space, root to root."
position = Vector2(-43.2, 0)

[node name="Work" parent="ActorMarkers" index="2"]
position = Vector2(-43.2, 0)

[node name="Rest" parent="ActorMarkers" index="3"]
editor_description = "He remains here after the conversation while mining control returns."
position = Vector2(-43.2, 0)

[node name="Exit" parent="ActorMarkers" index="4"]
editor_description = "No exit choreography: closing resolves at the same mark without hiding him."
position = Vector2(-43.2, 0)

[node name="EditorTerrainPreview" parent="." index="4"]
